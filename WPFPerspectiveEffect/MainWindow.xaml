<Window
    x:Class="WPFPerspectiveEffect.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:WPFPerspectiveEffect.Controls"
    xmlns:effects="clr-namespace:WPFPerspectiveEffect.Effects"
    WindowStartupLocation="CenterScreen"
    Width="1000"
    Height="700"
    MinWidth="800"
    MinHeight="500"
    ThemeMode="Dark"
    UseLayoutRounding="True"
    Title="WPF perspective effect">

    <Grid
        Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition
                Height="Auto"/>
            
            <RowDefinition/>
            
            <RowDefinition/>
            
            <RowDefinition/>

        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>

            <ColumnDefinition
                Width="Auto"/>
            
            <ColumnDefinition/>
            
            <ColumnDefinition
                Width="Auto"/>

        </Grid.ColumnDefinitions>

        <controls:Joystick
            Title="Top left"
            Grid.Row="1"
            MaxX="0.49"
            MinX="0"
            MaxY="0.49"
            MinY="0"
            OffsetChanged="TopLeftJoystick_OffsetChanged"/>

        <controls:Joystick
            Title="Top right"
            Grid.Row="1"
            Grid.Column="2"
            MaxX="1"
            MinX="0.49"
            MaxY="0.49"
            MinY="0"
            OffsetChanged="TopRigthJoystick_OffsetChanged"/>

        <controls:Joystick
            x:Name="PART_StickBottomLeft"
            Title="Bottom left"
            Grid.Row="3"
            MaxX="0.49"
            MinX="0"
            MaxY="1"
            MinY="0.49"
            OffsetChanged="BottomLeftJoystick_OffsetChanged"/>

        <controls:Joystick
            x:Name="PART_StickBottomRight"
            Title="Bottom right"
            Grid.Row="3"
            Grid.Column="2"
            MaxX="1"
            MinX="0.49"
            MaxY="1"
            MinY="0.49"
            OffsetChanged="BottomRightJoystick_OffsetChanged"/>

        <Border
            CornerRadius="20"
            Grid.Row="1"
            Grid.RowSpan="3"
            Grid.Column="1"
            Margin="50">

            <Border.Background>

                <LinearGradientBrush
                    StartPoint="0.3, 0"
                    EndPoint="0.7, 1">

                    <GradientStop
                        Color="#77E"
                        Offset="0"/>

                    <GradientStop
                        Color="#A74CDB"
                        Offset="1"/>

                </LinearGradientBrush>
                
            </Border.Background>
            
            <Border.Effect>

                <effects:PerspectiveEffect
                    x:Name="PART_Perspective"/>

            </Border.Effect>

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition/>

                    <RowDefinition/>

                    <RowDefinition/>

                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition/>

                    <ColumnDefinition/>

                    <ColumnDefinition/>

                </Grid.ColumnDefinitions>

                <Viewbox
                    Grid.Row="1"
                    Grid.Column="1">

                    <TextBlock
                        Text="Expample"
                        FontFamily="{StaticResource Comfortaa}"
                        FontSize="40"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        FontWeight="Black"
                        Foreground="#CCE"/>

                </Viewbox>

            </Grid>

        </Border>

    </Grid>
    
</Window>