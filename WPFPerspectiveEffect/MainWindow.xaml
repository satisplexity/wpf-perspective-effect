<Window
    x:Class="WPFPerspectiveEffect.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:WPFPerspectiveEffect.Controls"
    WindowStartupLocation="CenterScreen"
    Width="1000"
    Height="700"
    MinWidth="800"
    MinHeight="500"
    ThemeMode="Dark"
    UseLayoutRounding="True"
    Title="WPF perspective effect">

    <Grid
        Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition/>
            
            <RowDefinition/>
            
            <RowDefinition/>
            
            <RowDefinition/>

        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>

            <ColumnDefinition
                Width="Auto"/>
            
            <ColumnDefinition/>
            
            <ColumnDefinition
                Width="Auto"/>

        </Grid.ColumnDefinitions>

        <controls:Joystick
            Title="Top left"
            Grid.Row="1"/>

        <controls:Joystick
            Title="Top right"
            Grid.Row="1"
            Grid.Column="2"/>

        <controls:Joystick
            Title="Bottom left"
            Grid.Row="3"/>

        <controls:Joystick
            Title="Bottom right"
            Grid.Row="3"
            Grid.Column="2"/>

    </Grid>
    
</Window>